generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  PRO
}

// Weights are stored in pounds throughout — that is what every existing row
// already holds — and converted at the edges for display and input. Storing
// one canonical unit keeps history unambiguous when a user switches.
enum WeightUnit {
  LB
  KG
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  GRACE_PERIOD
  BILLING_RETRY
  REVOKED
}

model Users {
  id                    String            @id @default(uuid())
  admin                 Boolean           @default(false)
  username              String            @unique
  password              String
  email                 String?           @unique
  verified              Boolean           @default(false)
  lastLogin             DateTime          @default(now()) @db.Date
  // Entitlement is denormalised onto the user because the JWT strategy
  // already loads this row on every authenticated request, so reading it
  // costs nothing extra. Subscription below is the audit trail.
  // A null planExpiresAt on a PRO user means it never lapses.
  plan                  Plan              @default(FREE)
  planExpiresAt         DateTime?
  // Set for early users granted PRO without paying, so "paying" and
  // "granted" stay distinguishable in support and analytics.
  grandfatheredAt       DateTime?
  weightUnit            WeightUnit        @default(LB)
  tokens                Token?
  weights               WeightEntry[]
  userWorkouts          UserWorkout[]     @relation("UserWorkouts")
  createdGlobalWorkouts GlobalWorkout[]   @relation("CreatedGlobalWorkouts")
  WorkoutTemplate       WorkoutTemplate[]
  sessions              WorkoutSession[]
  subscriptions         Subscription[]

  @@map("users")
}

// One row per store subscription. Written by the store's server-to-server
// notifications, never by the client — otherwise refunds and cancellations
// would never revoke access.
model Subscription {
  id                    String             @id @default(uuid())
  userId                String
  store                 String // "apple" | "google" | "stripe"
  productId             String
  originalTransactionId String             @unique // stable per subscriber
  status                SubscriptionStatus
  expiresAt             DateTime?
  autoRenew             Boolean            @default(true)
  // Sandbox receipts must never grant production entitlement.
  environment           String             @default("production")
  lastVerifiedAt        DateTime           @default(now())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  Users              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscription")
}

// Global canonical workouts - shared across all users
model GlobalWorkout {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  muscleGroup  String? // e.g., "chest", "back", "shoulders"
  equipment    String? // e.g., "barbell", "dumbbell", "machine"
  description  String?
  isApproved   Boolean       @default(true) // Admin approved workouts
  createdBy    String? // User who suggested this workout
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userWorkouts UserWorkout[] // References from user workouts
  creator      Users?        @relation("CreatedGlobalWorkouts", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("global_workouts")
}

// User-specific workout instances
model UserWorkout {
  id               Int               @id @default(autoincrement())
  userId           String
  globalWorkoutId  Int? // Reference to global workout (null if user-created)
  customName       String? // Custom name if user wants to override global name
  userCreated      Boolean           @default(false) // True if this is a user-specific workout
  pendingApproval  Boolean           @default(false) // True if waiting for admin approval to become global
  supersettedId    Int?              @unique
  alternateId      Int?              @unique
  alt              Boolean           @default(false)
  ss               Boolean           @default(false)
  workoutId        Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  weights          WeightEntry[]
  globalWorkout    GlobalWorkout?    @relation(fields: [globalWorkoutId], references: [id], onDelete: SetNull)
  alternate        UserWorkout?      @relation("Alternate", fields: [alternateId], references: [id])
  primary          UserWorkout?      @relation("Alternate")
  relatedWorkout   UserWorkout?      @relation("RelatedWorkouts", fields: [workoutId], references: [id], map: "user_workout_related_fkey")
  relatedTo        UserWorkout[]     @relation("RelatedWorkouts")
  supersetted      UserWorkout?      @relation("Superset", fields: [supersettedId], references: [id])
  superset         UserWorkout?      @relation("Superset")
  user             Users             @relation("UserWorkouts", fields: [userId], references: [id], onDelete: Cascade)
  templateWorkouts TemplateWorkout[]
  sets             WorkoutSet[]

  @@index([userId])
  @@map("user_workouts")
}

model TemplateWorkout {
  id            Int             @id @default(autoincrement())
  templateId    Int
  userWorkoutId Int? // New user workout reference
  sets          Int
  reps          String
  amrap         Boolean         @default(false)
  template      WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userWorkout   UserWorkout?    @relation(fields: [userWorkoutId], references: [id], onDelete: Cascade)

  @@unique([templateId, userWorkoutId])
  @@map("template_workout")
}

model WorkoutTemplate {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  userId           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  templateWorkouts TemplateWorkout[]
  weightEntries    WeightEntry[]
  sessions         WorkoutSession[]
  user             Users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workout_template")
}

// A single training day. Groups every set performed in one gym visit so the
// user can review a workout as a unit instead of per-exercise silos.
model WorkoutSession {
  id         Int              @id @default(autoincrement())
  // Generated on the device so a workout can be created, edited and synced
  // while offline, and so a retried sync upserts instead of duplicating.
  clientId   String?
  userId     String
  templateId Int?
  name       String?
  date       DateTime         @default(now()) @db.Date
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       Users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sets       WorkoutSet[]

  @@unique([userId, clientId])
  @@index([userId, date])
  @@map("workout_session")
}

// One performed set: the actual weight and reps, not the prescribed scheme.
model WorkoutSet {
  id            Int            @id @default(autoincrement())
  clientId      String?
  sessionId     Int
  userWorkoutId Int
  setNumber     Int
  weight        Float
  reps          Int
  rpe           Int?
  isWarmup      Boolean        @default(false)
  completed     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userWorkout   UserWorkout    @relation(fields: [userWorkoutId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientId])
  @@index([sessionId, userWorkoutId])
  @@index([userWorkoutId])
  @@map("workout_set")
}

model WeightEntry {
  id            Int              @id @default(autoincrement())
  userId        String
  userWorkoutId Int? // New user workout reference
  templateId    Int?
  weight        Float
  date          DateTime         @default(now()) @db.Date
  user          Users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWorkout   UserWorkout?     @relation(fields: [userWorkoutId], references: [id], onDelete: Cascade)
  template      WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@map("weightentry")
}

model Token {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  token     String
  createdAt DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("((now() AT TIME ZONE 'UTC') + '01:00:00'::interval)"))
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}
